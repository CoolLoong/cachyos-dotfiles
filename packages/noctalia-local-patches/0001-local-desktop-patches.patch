@@ -0,0 +1,42 @@
+#pragma once
+
+#include "dbus/network/network_types.h"
+
+#include <map>
+#include <memory>
+#include <sdbus-c++/sdbus-c++.h>
+#include <string>
+#include <vector>
+
+class SystemBus;
+
+class NetworkDeviceDetails {
+public:
+  explicit NetworkDeviceDetails(SystemBus& bus);
+  ~NetworkDeviceDetails();
+  void refresh();
+  [[nodiscard]] const std::vector<WiredDeviceInfo>& wiredDevices() const noexcept { return m_devices; }
+  [[nodiscard]] bool wifiAutoconnect(const std::string& ssid) const;
+  void setWifiAutoconnect(const std::string& ssid, bool enabled);
+  void setWiredActive(const std::string& devicePath, bool enabled);
+  void preferWired();
+
+private:
+  using Settings = std::map<std::string, std::map<std::string, sdbus::Variant>>;
+  struct Profile {
+    std::string path;
+    std::string ssid;
+    std::string type;
+    bool autoconnect = true;
+    Settings settings;
+  };
+  void refreshProfiles();
+  void updateProfiles(std::vector<Profile> profiles, bool routePreference, bool enabled);
+  SystemBus& m_bus;
+  std::shared_ptr<int> m_lifetime;
+  std::vector<WiredDeviceInfo> m_devices;
+  std::vector<Profile> m_profiles;
+  bool m_devicesPending = false;
+  bool m_profilesPending = false;
+  bool m_writePending = false;
+};
