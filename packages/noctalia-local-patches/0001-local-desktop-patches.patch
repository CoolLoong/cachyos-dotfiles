diff --git a/src/dbus/network/local_network_policy.h b/src/dbus/network/local_network_policy.h
new file mode 100644
index 0000000..9a58cdd
--- /dev/null
+++ b/src/dbus/network/local_network_policy.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <sdbus-c++/sdbus-c++.h>
+#include <string>
+
+namespace local_network_policy {
+  using Settings = std::map<std::string, std::map<std::string, sdbus::Variant>>;
+
+  inline void setAutoconnect(Settings& settings, bool enabled) {
+    settings["connection"]["autoconnect"] = sdbus::Variant{enabled};
+  }
+
+  inline void preferWired(Settings& settings, bool wired) {
+    const std::int64_t metric = wired ? 100 : 600;
+    settings["ipv4"]["route-metric"] = sdbus::Variant{metric};
+    if (const auto ipv6 = settings.find("ipv6"); ipv6 != settings.end()) {
+      const auto method = ipv6->second.find("method");
+      if (method != ipv6->second.end() && method->second.get<std::string>() != "disabled")
+        ipv6->second["route-metric"] = sdbus::Variant{metric};
+    }
+  }
+}
diff --git a/src/dbus/network/network_device_details.cpp b/src/dbus/network/network_device_details.cpp
new file mode 100644
index 0000000..eb40599
--- /dev/null
+++ b/src/dbus/network/network_device_details.cpp
@@ -0,0 +1,222 @@
+#include "dbus/network/network_device_details.h"
+
+#include "core/log.h"
+#include "dbus/network/local_network_policy.h"
+#include "dbus/system_bus.h"
+#include "notification/notifications.h"
+
+#include <algorithm>
+#include <functional>
+#include <optional>
+#include <utility>
+
+namespace {
+  constexpr Logger kLog("network-patches");
+  const sdbus::ServiceName kService{"org.freedesktop.NetworkManager"};
+  constexpr auto kProperties = "org.freedesktop.DBus.Properties";
+  constexpr auto kDevice = "org.freedesktop.NetworkManager.Device";
+  constexpr auto kNm = "org.freedesktop.NetworkManager";
+  constexpr auto kConnection = "org.freedesktop.NetworkManager.Settings.Connection";
+  using Properties = std::map<std::string, sdbus::Variant>;
+  using Proxy = std::shared_ptr<sdbus::IProxy>;
+
+  template <typename T> T property(const Properties& values, const std::string& key, T fallback = {}) {
+    const auto it = values.find(key);
+    if (it == values.end()) return fallback;
+    try { return it->second.get<T>(); } catch (const sdbus::Error&) { return fallback; }
+  }
+
+  void getProperties(SystemBus& bus, const std::string& path, const std::string& interface,
+                     std::function<void(Properties)> done) {
+    try {
+      Proxy proxy = sdbus::createProxy(bus.connection(), kService, sdbus::ObjectPath{path});
+      proxy->callMethodAsync("GetAll").onInterface(kProperties).withArguments(interface)
+          .uponReplyInvoke([proxy, done](std::optional<sdbus::Error> error, Properties values) {
+            done(error ? Properties{} : std::move(values));
+          });
+    } catch (const sdbus::Error&) { done({}); }
+  }
+
+  void reportError(const sdbus::Error& error) {
+    kLog.warn("NetworkManager request failed: {}", error.what());
+    notify::error("NetworkManager", "网络设置失败 / Network request failed", error.getMessage());
+  }
+}
+
+NetworkDeviceDetails::NetworkDeviceDetails(SystemBus& bus)
+    : m_bus(bus), m_lifetime(std::make_shared<int>(0)) {}
+NetworkDeviceDetails::~NetworkDeviceDetails() { m_lifetime.reset(); }
+
+void NetworkDeviceDetails::refresh() {
+  refreshProfiles();
+  if (m_devicesPending) return;
+  m_devicesPending = true;
+  const std::weak_ptr<int> lifetime = m_lifetime;
+  try {
+    Proxy proxy = sdbus::createProxy(m_bus.connection(), kService, sdbus::ObjectPath{"/org/freedesktop/NetworkManager"});
+    proxy->callMethodAsync("GetDevices").onInterface(kNm)
+        .uponReplyInvoke([this, lifetime, proxy](std::optional<sdbus::Error> error, std::vector<sdbus::ObjectPath> paths) {
+          if (lifetime.expired()) return;
+          if (error || paths.empty()) {
+            m_devices.clear(); m_devicesPending = false; return;
+          }
+          struct Pending { std::size_t count; std::vector<WiredDeviceInfo> devices; };
+          auto pending = std::make_shared<Pending>();
+          pending->count = paths.size();
+          auto finish = [this, lifetime, pending]() {
+            if (lifetime.expired() || --pending->count != 0) return;
+            std::ranges::sort(pending->devices, {}, &WiredDeviceInfo::interfaceName);
+            m_devices = std::move(pending->devices); m_devicesPending = false;
+          };
+          for (const auto& path : paths) {
+            const std::string devicePath{path};
+            getProperties(m_bus, devicePath, kDevice, [this, lifetime, pending, finish, devicePath](Properties properties) {
+              if (lifetime.expired()) return;
+              const auto udi = property<std::string>(properties, "Udi");
+              if (property<std::uint32_t>(properties, "DeviceType") != 1U
+                  || udi.starts_with("/sys/devices/virtual/")
+                  || (property<std::uint32_t>(properties, "Capabilities") & 4U) != 0U) { finish(); return; }
+              auto row = std::make_shared<WiredDeviceInfo>();
+              row->path = devicePath;
+              row->interfaceName = property<std::string>(properties, "Interface");
+              row->state = property<std::uint32_t>(properties, "State");
+              row->autoconnect = property<bool>(properties, "Autoconnect", true);
+              row->managed = property<bool>(properties, "Managed", true);
+              const auto ipPath = property<sdbus::ObjectPath>(properties, "Ip4Config", sdbus::ObjectPath{"/"});
+              getProperties(m_bus, devicePath, "org.freedesktop.NetworkManager.Device.Wired",
+                  [this, lifetime, pending, finish, row, ipPath](Properties wired) {
+                    if (lifetime.expired()) return;
+                    row->carrier = property<bool>(wired, "Carrier");
+                    row->speedMbps = property<std::uint32_t>(wired, "Speed");
+                    row->macAddress = property<std::string>(wired, "HwAddress");
+                    if (ipPath == sdbus::ObjectPath{"/"}) { pending->devices.push_back(*row); finish(); return; }
+                    getProperties(m_bus, std::string(ipPath), "org.freedesktop.NetworkManager.IP4Config",
+                        [lifetime, pending, finish, row](Properties ip) {
+                          if (lifetime.expired()) return;
+                          auto addresses = property<std::vector<Properties>>(ip, "AddressData");
+                          if (!addresses.empty()) row->ipv4 = property<std::string>(addresses.front(), "address");
+                          pending->devices.push_back(*row); finish();
+                        });
+                  });
+            });
+          }
+        });
+  } catch (const sdbus::Error&) { m_devicesPending = false; m_devices.clear(); }
+}
+
+void NetworkDeviceDetails::refreshProfiles() {
+  if (m_profilesPending || m_writePending) return;
+  m_profilesPending = true;
+  const std::weak_ptr<int> lifetime = m_lifetime;
+  try {
+    Proxy proxy = sdbus::createProxy(m_bus.connection(), kService, sdbus::ObjectPath{"/org/freedesktop/NetworkManager/Settings"});
+    proxy->callMethodAsync("ListConnections").onInterface("org.freedesktop.NetworkManager.Settings")
+        .uponReplyInvoke([this, lifetime, proxy](std::optional<sdbus::Error> error, std::vector<sdbus::ObjectPath> paths) {
+          if (lifetime.expired()) return;
+          if (error || paths.empty()) { m_profilesPending = false; m_profiles.clear(); return; }
+          struct Pending { std::size_t count; std::vector<Profile> profiles; };
+          auto pending = std::make_shared<Pending>(); pending->count = paths.size();
+          auto finish = [this, lifetime, pending]() {
+            if (lifetime.expired() || --pending->count != 0) return;
+            m_profiles = std::move(pending->profiles); m_profilesPending = false;
+          };
+          for (const auto& path : paths) {
+            try {
+              Proxy connection = sdbus::createProxy(m_bus.connection(), kService, path);
+              connection->callMethodAsync("GetSettings").onInterface(kConnection)
+                  .uponReplyInvoke([lifetime, connection, pending, finish, path](std::optional<sdbus::Error> getError, Settings settings) {
+                    if (lifetime.expired()) return;
+                    if (!getError) {
+                      auto type = property<std::string>(settings["connection"], "type");
+                      if (type == "802-3-ethernet" || type == "802-11-wireless") {
+                        Profile profile;
+                        profile.path = std::string(path); profile.type = type;
+                        profile.autoconnect = property<bool>(settings["connection"], "autoconnect", true);
+                        if (type == "802-11-wireless") {
+                          auto bytes = property<std::vector<std::uint8_t>>(settings["802-11-wireless"], "ssid");
+                          profile.ssid.assign(bytes.begin(), bytes.end());
+                        }
+                        profile.settings = std::move(settings);
+                        pending->profiles.push_back(std::move(profile));
+                      }
+                    }
+                    finish();
+                  });
+            } catch (const sdbus::Error&) { finish(); }
+          }
+        });
+  } catch (const sdbus::Error&) { m_profilesPending = false; }
+}
+
+bool NetworkDeviceDetails::wifiAutoconnect(const std::string& ssid) const {
+  return std::ranges::any_of(m_profiles, [&](const Profile& profile) { return profile.type == "802-11-wireless" && (ssid.empty() || profile.ssid == ssid) && profile.autoconnect; });
+}
+
+void NetworkDeviceDetails::setWifiAutoconnect(const std::string& ssid, bool enabled) {
+  std::vector<Profile> profiles;
+  for (const auto& profile : m_profiles) {
+    if (profile.type == "802-11-wireless" && (ssid.empty() || profile.ssid == ssid)) profiles.push_back(profile);
+  }
+  updateProfiles(std::move(profiles), false, enabled);
+}
+
+void NetworkDeviceDetails::preferWired() { updateProfiles(m_profiles, true, true); }
+
+void NetworkDeviceDetails::updateProfiles(std::vector<Profile> profiles, bool routePreference, bool enabled) {
+  if (m_writePending || profiles.empty()) return;
+  m_writePending = true;
+  const std::weak_ptr<int> lifetime = m_lifetime;
+  struct Pending { std::size_t count; bool failed = false; };
+  auto pending = std::make_shared<Pending>(); pending->count = profiles.size();
+  auto finish = [this, lifetime, pending, routePreference](std::optional<sdbus::Error> error) {
+    if (lifetime.expired()) return;
+    if (error) { pending->failed = true; reportError(*error); }
+    if (--pending->count != 0) return;
+    m_writePending = false;
+    if (!pending->failed && routePreference) notify::info("NetworkManager", "有线优先 / Prefer wired", "已保存，下次连接时生效。 / Saved for the next connection.");
+    refresh();
+  };
+  for (auto& profile : profiles) {
+    if (routePreference) {
+      local_network_policy::preferWired(profile.settings, profile.type == "802-3-ethernet");
+    } else local_network_policy::setAutoconnect(profile.settings, enabled);
+    try {
+      Proxy connection = sdbus::createProxy(m_bus.connection(), kService, sdbus::ObjectPath{profile.path});
+      connection->callMethodAsync("Update2").onInterface(kConnection)
+          .withArguments(profile.settings, std::uint32_t{1}, Properties{})
+          .uponReplyInvoke([connection, finish](std::optional<sdbus::Error> error, Properties) { finish(error); });
+    } catch (const sdbus::Error& error) { finish(error); }
+  }
+}
+
+void NetworkDeviceDetails::setWiredActive(const std::string& devicePath, bool enabled) {
+  if (std::ranges::none_of(m_devices, [&](const WiredDeviceInfo& device) { return device.path == devicePath; })) return;
+  const std::weak_ptr<int> lifetime = m_lifetime;
+  try {
+    Proxy device = sdbus::createProxy(m_bus.connection(), kService, sdbus::ObjectPath{devicePath});
+    if (!enabled) {
+      device->callMethodAsync("Disconnect").onInterface(kDevice)
+          .uponReplyInvoke([this, lifetime, device](std::optional<sdbus::Error> error) {
+            if (lifetime.expired()) return;
+            if (error) reportError(*error);
+            refresh();
+          });
+      return;
+    }
+    device->setPropertyAsync("Autoconnect").onInterface(kDevice).toValue(true)
+        .uponReplyInvoke([this, lifetime, device, devicePath](std::optional<sdbus::Error> error) {
+          if (lifetime.expired()) return;
+          if (error) { reportError(*error); return; }
+          try {
+            Proxy manager = sdbus::createProxy(m_bus.connection(), kService, sdbus::ObjectPath{"/org/freedesktop/NetworkManager"});
+            manager->callMethodAsync("ActivateConnection").onInterface(kNm)
+                .withArguments(sdbus::ObjectPath{"/"}, sdbus::ObjectPath{devicePath}, sdbus::ObjectPath{"/"})
+                .uponReplyInvoke([this, lifetime, manager](std::optional<sdbus::Error> activateError, sdbus::ObjectPath) {
+                  if (lifetime.expired()) return;
+                  if (activateError) reportError(*activateError);
+                  refresh();
+                });
+          } catch (const sdbus::Error& activateError) { reportError(activateError); }
+        });
+  } catch (const sdbus::Error& error) { reportError(error); }
+}
diff --git a/src/dbus/network/network_device_details.h b/src/dbus/network/network_device_details.h
new file mode 100644
