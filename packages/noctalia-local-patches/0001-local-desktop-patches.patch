diff --git a/tests/button_layout_test.cpp b/tests/button_layout_test.cpp
index c303abb..fde87b9 100644
--- a/tests/button_layout_test.cpp
+++ b/tests/button_layout_test.cpp
@@ -3,6 +3,8 @@
 #include "ui/controls/button.h"
 #include "ui/controls/glyph.h"
 #include "ui/controls/label.h"
+#include "ui/controls/segmented.h"
+#include "ui/controls/separator.h"
 #include "ui/style.h"
 
 #include <algorithm>
@@ -190,5 +192,65 @@ int main() {
     return 1;
   }
 
+  // Launcher category names must retain their full text budget at narrow panel
+  // widths and larger UI scales, flowing onto additional rows instead of eliding.
+  for (const float scale : {1.0F, 1.5F}) {
+    for (const float width : {260.0F, 560.0F, 1040.0F}) {
+      Segmented categories;
+      categories.setScale(scale);
+      categories.setCompact(true);
+      categories.setAlign(FlexAlign::Center);
+      categories.setWrap(true);
+      const std::vector<std::string_view> names{"Internet", "Development", "Graphics", "Audio",
+                                                "Video",    "Office",      "System",   "Utilities"};
+      for (const auto name : names) {
+        categories.addOption(name, "apps");
+      }
+      LayoutConstraints constraints;
+      constraints.setExactWidth(width);
+      const LayoutSize measured = categories.measure(renderer, constraints);
+      categories.arrange(renderer, LayoutRect{.width = width, .height = measured.height});
+      std::size_t buttonCount = 0;
+      bool hasAdditionalRow = false;
+      for (const auto& child : categories.children()) {
+        if (const auto* separator = dynamic_cast<const Separator*>(child.get())) {
+          if (separator->participatesInLayout() || separator->visible()) {
+            std::println(stderr, "button_layout_test: wrapped category separator occupies a row");
+            return 1;
+          }
+        }
+        const auto* option = dynamic_cast<const Button*>(child.get());
+        if (option == nullptr) {
+          continue;
+        }
+        if (buttonCount >= names.size()) {
+          std::println(stderr, "button_layout_test: unexpected category button");
+          return 1;
+        }
+        const Label* label = option->label();
+        const float textWidth = static_cast<float>(names[buttonCount].size()) * 10.0F;
+        if (label == nullptr
+            || (label->maxWidth() > 0.0F && label->maxWidth() + 0.01F < textWidth)
+            || option->x() + option->width() > width + 0.01F
+            || option->y() + option->height() > measured.height + 0.01F) {
+          std::println(
+              stderr,
+              "button_layout_test: category {} clipped width={} scale={} budget={} expected={} box=({},{},{},{}) "
+              "totalHeight={}",
+              names[buttonCount], width, scale, label == nullptr ? -1.0F : label->maxWidth(), textWidth, option->x(),
+              option->y(), option->width(), option->height(), measured.height
+          );
+          return 1;
+        }
+        hasAdditionalRow = hasAdditionalRow || option->y() > 0.0F;
+        ++buttonCount;
+      }
+      if (buttonCount != names.size() || (width == 260.0F && !hasAdditionalRow)) {
+        std::println(stderr, "button_layout_test: category options did not flow onto rows");
+        return 1;
+      }
+    }
+  }
+
   return 0;
 }
diff --git a/tests/local_desktop_patches_test.cpp b/tests/local_desktop_patches_test.cpp
new file mode 100644
index 0000000..73cb2b9
--- /dev/null
+++ b/tests/local_desktop_patches_test.cpp
@@ -0,0 +1,37 @@
+#include "dbus/network/local_network_policy.h"
+#include "system/local_desktop_presentation.h"
+
+#include <cassert>
+#include <iostream>
+
+int main() {
+  using namespace local_desktop_presentation;
+  assert(diskGigabytes(500e9, 2000e9) == "500.0 / 2000.0 GB (25%)");
+  assert(diskGigabytes(0, 0) == "0.0 / 0.0 GB (0%)");
+  assert(diskGigabytes(512345678901.0, 2000000000000.0) == "512.3 / 2000.0 GB (26%)");
+  assert(trayCellExtent(20, 1) == 22);
+  assert(trayCellExtent(20, 0) == 20);
+  assert(trayCellExtent(20, -3) == 20);
+  local_network_policy::Settings settings{
+    {"connection", {{"id", sdbus::Variant{std::string{"existing-profile"}}}, {"autoconnect", sdbus::Variant{true}}}},
+    {"802-11-wireless", {{"ssid", sdbus::Variant{std::vector<std::uint8_t>{1, 2, 3}}}}},
+    {"802-11-wireless-security", {{"psk", sdbus::Variant{std::string{"fixture-secret"}}}}},
+    {"ipv4", {{"method", sdbus::Variant{std::string{"manual"}}}, {"gateway", sdbus::Variant{std::string{"10.0.0.1"}}}}},
+    {"ipv6", {{"method", sdbus::Variant{std::string{"disabled"}}}}},
+  };
+  local_network_policy::setAutoconnect(settings, false);
+  assert(!settings.at("connection").at("autoconnect").get<bool>());
+  assert(settings.at("connection").at("id").get<std::string>() == "existing-profile");
+  assert(settings.at("802-11-wireless-security").at("psk").get<std::string>() == "fixture-secret");
+  local_network_policy::preferWired(settings, true);
+  assert(settings.at("ipv4").at("route-metric").get<std::int64_t>() == 100);
+  assert(settings.at("ipv4").at("method").get<std::string>() == "manual");
+  assert(settings.at("ipv4").at("gateway").get<std::string>() == "10.0.0.1");
+  assert(!settings.at("ipv6").contains("route-metric"));
+  local_network_policy::preferWired(settings, false);
+  assert(settings.at("ipv4").at("route-metric").get<std::int64_t>() == 600);
+  settings.erase("ipv6");
+  local_network_policy::preferWired(settings, true);
+  assert(!settings.contains("ipv6"));
+  std::cout << "GB formatting, tray geometry and profile preservation passed\n";
+}
diff --git a/tests/local_network_probe.cpp b/tests/local_network_probe.cpp
new file mode 100644
index 0000000..55d9ee0
--- /dev/null
+++ b/tests/local_network_probe.cpp
@@ -0,0 +1,26 @@
+#include "dbus/network/network_device_details.h"
+#include "dbus/system_bus.h"
+#include <chrono>
+#include <iostream>
+#include <nlohmann/json.hpp>
+#include <thread>
+
+int main(int argc, char** argv) {
+  SystemBus bus;
+  NetworkDeviceDetails details(bus);
+  details.refresh();
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+  while (std::chrono::steady_clock::now() < deadline) {
+    bus.processPendingEvents();
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  nlohmann::json result = nlohmann::json::array();
+  bool found = argc < 2;
+  for (const auto& device : details.wiredDevices()) {
+    if (argc >= 2 && device.interfaceName == argv[1]) found = true;
+    result.push_back({{"interface", device.interfaceName}, {"state", device.state},
+        {"carrier", device.carrier}, {"speed_mbps", device.speedMbps}, {"ipv4", device.ipv4}});
+  }
+  std::cout << result.dump(2) << '\n';
+  return found ? 0 : 1;
+}
