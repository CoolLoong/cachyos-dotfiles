pkgname=noctalia-local-patches
pkgver=5.3.0.p2
pkgrel=1
pkgdesc='Independent Noctalia 5.3.0 desktop usability patches'
arch=('x86_64')
url='https://github.com/noctalia-dev/noctalia'
license=('MIT')
depends=('noctalia>=5.3.0' 'python' 'systemd')
makedepends=('clang' 'meson' 'ninja' 'pkgconf' 'wayland-protocols' 'nlohmann-json' 'stb')
optdepends=('niri: autostart switching with noctalia-patches')
options=('!debug')
_commit=a33122c4208a385e19c9a252e65e2751b2c44fbb
source=(
  "noctalia-a33122c.tar.gz::https://codeload.github.com/noctalia-dev/noctalia/tar.gz/${_commit}"
  '0001-local-desktop-patches.patch'
  'noctalia-patched'
  'noctalia-patches'
  'control.py'
  'README.txt'
)
sha256sums=(
  '33c7ae74d160665fe0363d4dcdfee03808e792da6eb067832efb2a4c3b32e073'
  'caaf28ca1a5bd129cd993fedeb0b47238956329cd77f4e535d93348913aa066d'
  '42ed1cf114a10c4af4aba98a49911367bd4a8a3c9cbd4a01c1b965b776225780'
  '8fac7c14ce0a54922bd476290c392c150295c1f507b034c296fdafb8a417f38c'
  '4d61e0f74c2234e79dd8282c79804e125ad046f93383c2cac4d90713f0204433'
  '8f233395e6c82b493d1f6e92fc21592fbf2ed54824dc2e62807111f2c76c1359'
)

prepare() {
  cd "${srcdir}/noctalia-${_commit}"
  patch -Np1 -i "${srcdir}/0001-local-desktop-patches.patch"
}

build() {
  local builddir=$(realpath -m "${srcdir}/build")
  local sourcedir=$(realpath "${srcdir}/noctalia-${_commit}")
  if [[ -f "${srcdir}/build/build.ninja" ]]; then
    meson setup --reconfigure "${builddir}" "${sourcedir}" -Dtests=enabled
  else
    CC=clang CXX=clang++ meson setup "${builddir}" "${sourcedir}" \
      --prefix=/usr/lib/noctalia-local-patches --buildtype=release \
      -Doptimization=2 -Ddebug=false -Dtests=enabled -Db_lto=false
  fi
  meson compile -C "${builddir}" -j"${NOCTALIA_BUILD_JOBS:-2}" noctalia button_layout_test
}

check() {
  env -i HOME="$HOME" PATH="$PATH" LANG=C.UTF-8 meson test -C "${srcdir}/build" --no-rebuild button_layout
  clang++ -std=c++23 -I"${srcdir}/noctalia-${_commit}/src" \
    "${srcdir}/noctalia-${_commit}/tests/local_desktop_patches_test.cpp" \
    $(pkg-config --cflags --libs sdbus-c++) -o "${srcdir}/local_desktop_patches_test"
  "${srcdir}/local_desktop_patches_test"
}

package() {
  local private="${pkgdir}/usr/lib/noctalia-local-patches"
  install -Dm755 "${srcdir}/build/noctalia" "${private}/bin/noctalia"
  install -dm755 "${private}/share/noctalia"
  cp -a "${srcdir}/noctalia-${_commit}/assets" "${private}/share/noctalia/assets"
  install -Dm644 "${srcdir}/control.py" "${private}/control.py"
  install -Dm755 "${srcdir}/noctalia-patched" "${pkgdir}/usr/bin/noctalia-patched"
  install -Dm755 "${srcdir}/noctalia-patches" "${pkgdir}/usr/bin/noctalia-patches"
  install -Dm644 "${srcdir}/README.txt" "${pkgdir}/usr/share/doc/${pkgname}/README.txt"
  install -Dm644 "${srcdir}/0001-local-desktop-patches.patch" "${pkgdir}/usr/share/doc/${pkgname}/0001-local-desktop-patches.patch"
  install -Dm644 "${srcdir}/noctalia-${_commit}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
